# Early bring-up and Android interface groundwork, NOT a complete Android config.
CONFIG_LOCALVERSION="-rabbit-r1-bringup"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARM64_4K_PAGES=y
CONFIG_COMPAT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_MFD_MT6397=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_RTC_NVMEM=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_BATTERY_MT6357=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_REGULATOR_MT6357=y
CONFIG_MEDIATEK_MT6359_AUXADC=y
CONFIG_MEDIATEK_MT6370_ADC=y
CONFIG_SENSORS_IIO_HWMON=y
CONFIG_MMC_MTK=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_BLK=m
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y
# Let configfs claim the UDC; the inherited legacy gadgets bind automatically.
# CONFIG_USB_ETH is not set
# CONFIG_USB_G_HID is not set
# Retain firmware CPU clocks until DVFS and suspend are measured on the r1.
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_PSI=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,bpf"
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_SNAPSHOT=y
# DM_USER is an Android downstream extension absent from this kernel.
# Do not enable virtual A/B userspace snapshots until that is addressed.
# Smaller build artifacts; vmlinux and System.map still retained.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DRM_PANEL_RABBIT_R1=y
# Panel sequence compiled; host timing and power handoff remain unfinished.
# CONFIG_DRM_MEDIATEK is not set
# CONFIG_DRM_POWERVR is not set
