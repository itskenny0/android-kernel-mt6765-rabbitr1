+
+	if (rdma->data->mt6765)
+		writel(~(u32)RDMA_FRAME_END_INT, rdma->regs + DISP_REG_RDMA_INT_STATUS);
+
 	rdma_update_bits(dev, DISP_REG_RDMA_INT_ENABLE, RDMA_FRAME_END_INT,
 			 RDMA_FRAME_END_INT);
 }
