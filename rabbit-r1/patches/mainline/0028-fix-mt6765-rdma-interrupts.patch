 	clk_disable_unprepare(rdma->clk);
 	rdma->config_valid = false;
 	rdma->clock_rate = 0;
@@ -243,6 +301,9 @@ void mtk_rdma_start(struct device *dev)
 	if (rdma->data->mt6765 && !rdma->config_valid)
