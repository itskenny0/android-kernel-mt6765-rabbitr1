 arch/arm64/boot/dts/mediatek/mt6765.dtsi          |   4 +
 drivers/i2c/busses/i2c-mt65xx.c                   | 299 ++++++++++++++++------
 include/linux/soc/mediatek/mtk_sip_svc.h          |   3 +
 4 files changed, 227 insertions(+), 83 deletions(-)

