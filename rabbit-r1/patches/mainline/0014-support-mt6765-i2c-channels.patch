+static void mtk_i2c_reset_dma(struct mtk_i2c *i2c)
+{
+	writel(I2C_DMA_HARD_RST, i2c->pdmabase + OFFSET_RST);
+	udelay(50);
+	writel(I2C_DMA_CLR_FLAG, i2c->pdmabase + OFFSET_RST);
+}
+
+static void mtk_i2c_init_hw(struct mtk_i2c *i2c)
+{
+	u16 intr_stat_reg;
+
+	if (i2c->dev_comp->ap_irq_gate)
+		mtk_i2c_writew_bank(i2c, 0, 0, OFFSET_INTR_MASK);
+	mtk_i2c_writew_bank(i2c, 0, I2C_CHN_CLR_FLAG, OFFSET_START);
+	intr_stat_reg = mtk_i2c_readw_bank(i2c, 0, OFFSET_INTR_STAT);
+	mtk_i2c_writew_bank(i2c, 0, intr_stat_reg, OFFSET_INTR_STAT);
+
+	if (i2c->dev_comp->apdma_sync) {
+		writel(I2C_DMA_WARM_RST, i2c->pdmabase + OFFSET_RST);
+		udelay(10);
+		writel(I2C_DMA_CLR_FLAG, i2c->pdmabase + OFFSET_RST);
+		udelay(10);
+		writel(I2C_DMA_HANDSHAKE_RST | I2C_DMA_HARD_RST,
+		       i2c->pdmabase + OFFSET_RST);
+		mtk_i2c_writew_bank(i2c, 0, I2C_HANDSHAKE_RST | I2C_SOFT_RST,
+				    OFFSET_SOFTRESET);
+		udelay(10);
+		writel(I2C_DMA_CLR_FLAG, i2c->pdmabase + OFFSET_RST);
+		mtk_i2c_writew_bank(i2c, 0, I2C_CHN_CLR_FLAG, OFFSET_SOFTRESET);
+	} else {
+		mtk_i2c_reset_dma(i2c);
+		mtk_i2c_writew_bank(i2c, 0, I2C_SOFT_RST, OFFSET_SOFTRESET);
+	}
+
+	mtk_i2c_configure(i2c, 0);
+	if (i2c->ch_offset) {
+		mtk_i2c_writew(i2c, 0, OFFSET_INTR_MASK);
+		intr_stat_reg = mtk_i2c_readw(i2c, OFFSET_INTR_STAT);
+		mtk_i2c_writew(i2c, intr_stat_reg, OFFSET_INTR_STAT);
+	}
+}
+
+static void mtk_i2c_recover(struct mtk_i2c *i2c, bool completed)
+{
+	u16 start;
+
+	if (!i2c->ch_offset) {
+		mtk_i2c_init_hw(i2c);
+		return;
+	}
+
+	start = mtk_i2c_readw(i2c, OFFSET_START);
+	mtk_i2c_writew(i2c, I2C_FIFO_ADDR_CLR_MCH | I2C_FIFO_ADDR_CLR,
+		       OFFSET_FIFO_ADDR_CLR);
+	/* Completed channel errors must not reset another owner's transfer. */
+	if (completed && (i2c->irq_stat & I2C_TRANSAC_COMP) &&
+	    !(i2c->irq_stat & I2C_BUS_ERR)) {
+		mtk_i2c_reset_dma(i2c);
+		return;
+	}
+
+	mtk_i2c_init_hw(i2c);
+	if (completed || (start & I2C_RESUME_ARBIT))
+		mtk_i2c_writew_bank(i2c, 0, I2C_RESUME_ARBIT, OFFSET_START);
+}
+
+static int mtk_i2c_prepare_hw(struct mtk_i2c *i2c)
+{
+	int ret;
+
+	ret = clk_bulk_prepare_enable(I2C_MT65XX_CLK_MAX, i2c->clocks);
+	if (ret)
+		return ret;
+	i2c->clocks_prepared = true;
+
+	ret = mtk_i2c_enable_channel(i2c);
+	if (ret) {
+		clk_bulk_disable_unprepare(I2C_MT65XX_CLK_MAX, i2c->clocks);
+		i2c->clocks_prepared = false;
+		return ret;
+	}
+	mtk_i2c_init_hw(i2c);
+	clk_bulk_disable(I2C_MT65XX_CLK_MAX, i2c->clocks);
+	return 0;
 }
 
