index 1c095767d6..b90765e41b 100644
--- a/arch/arm64/boot/dts/mediatek/mt6765-rabbit-r1.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6765-rabbit-r1.dts
@@ -121,8 +121,8 @@ &i2c4 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&r1_i2c4_pins>;
 	clock-frequency = <100000>;
-	/* Stock uses AP channel 0x100; the current host driver lacks routing. */
-	status = "disabled";
+	/* Experimental: stock AP channel and touch wiring, not board-tested. */
+	status = "okay";
 
 	touchscreen@15 {
 		/* Primary vendor configuration; CST328 variants need another driver. */
