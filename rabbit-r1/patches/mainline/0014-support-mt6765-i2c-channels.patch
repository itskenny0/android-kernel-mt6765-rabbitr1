+static u16 mtk_i2c_readw_bank(struct mtk_i2c *i2c, u16 bank,
+			    enum I2C_REGS_OFFSET reg)
+{
+	return readw(i2c->base + bank + i2c->dev_comp->regs[reg]);
+}
+
+static void mtk_i2c_writew_bank(struct mtk_i2c *i2c, u16 bank, u16 val,
+			      enum I2C_REGS_OFFSET reg)
