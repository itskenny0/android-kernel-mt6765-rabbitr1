 static u16 mtk_i2c_irq_mask(struct mtk_i2c *i2c)
 {
-	return I2C_HS_NACKERR | I2C_ACKERR | I2C_ARB_LOST | I2C_TRANSAC_COMP |
-	       (i2c->auto_restart ? I2C_RS_TRANSFER : 0) |
-	       i2c->dev_comp->error_irq_mask;
+	u16 mask = I2C_HS_NACKERR | I2C_ACKERR | I2C_ARB_LOST |
+		   I2C_TRANSAC_COMP | i2c->dev_comp->error_irq_mask;
+
+	/* A channel reports ACK/NACK with completion, after bus ownership ends. */
+	if (i2c->ch_offset)
+		return mask & ~(I2C_HS_NACKERR | I2C_ACKERR);
+	return mask | (i2c->auto_restart ? I2C_RS_TRANSFER : 0);
+}
+
+static int mtk_i2c_enable_channel(struct mtk_i2c *i2c)
+{
+	struct arm_smccc_res res;
+
+	if (!i2c->ch_offset)
+		return 0;
+
+	arm_smccc_smc(MTK_SIP_I2C_CONTROL, i2c->secure_id,
+		      i2c->dev_comp->regs[OFFSET_MULTI_DMA],
+		      I2C_SHADOW_REG_MODE, 0, 0, 0, 0, &res);
+	if (res.a0) {
+		dev_err(i2c->dev, "firmware rejected channel setup: %#lx\n",
+			res.a0);
+		return -EIO;
+	}
+	return 0;
 }
 
