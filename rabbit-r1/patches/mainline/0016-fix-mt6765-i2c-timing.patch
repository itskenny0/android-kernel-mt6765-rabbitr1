 	mtk_i2c_writew_bank(i2c, bank, control_reg, OFFSET_CONTROL);
-	mtk_i2c_writew_bank(i2c, bank, I2C_DELAY_LEN, OFFSET_DELAY_LEN);
+	mtk_i2c_writew_bank(i2c, bank,
