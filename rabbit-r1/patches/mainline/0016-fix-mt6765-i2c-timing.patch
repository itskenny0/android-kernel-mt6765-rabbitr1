+	}
 
 	if (i2c->speed_hz <= I2C_MAX_STANDARD_MODE_FREQ)
 		ext_conf_val = I2C_ST_START_CON;
 	else
 		ext_conf_val = I2C_FS_START_CON;
+	if (i2c->dev_comp->mt6765_timing &&
+	    i2c->speed_hz > I2C_MAX_STANDARD_MODE_FREQ)
