 static void mtk_i2c_reset_dma(struct mtk_i2c *i2c)
@@ -1067,7 +1090,83 @@ static int mtk_i2c_calculate_speed(struct mtk_i2c *i2c, unsigned int clk_src,
 	return 0;
 }
 
-static void mtk_i2c_set_speed(struct mtk_i2c *i2c, unsigned int parent_clk)
+/* MT6765 uses a raw step count when the sample divider is one. */
+static int mtk_i2c_mt6765_counts(unsigned int clk_src, unsigned int speed,
+				unsigned int *step, unsigned int *sample)
+{
+	unsigned int hclk = clk_src / 1000;
+	unsigned int khz = speed / 1000;
+	unsigned int max_step, min_div, best, s, n;
+
+	if (!hclk || !khz || speed > I2C_MAX_HIGH_SPEED_MODE_FREQ)
+		return -EINVAL;
+	max_step = speed > I2C_MAX_FAST_MODE_FREQ ?
+		   MAX_HS_STEP_CNT_DIV : MAX_STEP_CNT_DIV;
+	min_div = DIV_ROUND_UP(hclk >> 1, khz);
+	best = MAX_SAMPLE_CNT_DIV * max_step + 1;
+	for (s = 1; s <= MAX_SAMPLE_CNT_DIV; s++) {
+		n = DIV_ROUND_UP(min_div, s);
+		if (!n || n > max_step || (s == 1 && n == MAX_STEP_CNT_DIV))
+			continue;
+		if (s * n < best) {
+			best = s * n;
+			*sample = s - 1;
+			*step = s == 1 ? n : n - 1;
+		}
+	}
+	if (best > MAX_SAMPLE_CNT_DIV * max_step || hclk / (2 * best) > khz)
+		return -EINVAL;
+	return 0;
+}
+
+static int mtk_i2c_set_speed_mt6765(struct mtk_i2c *i2c, unsigned int parent_clk)
+{
+	unsigned int clk_src, step, sample, low_step, low_sample, duty = 50;
+	unsigned int speed = i2c->speed_hz;
+	u16 timing, ltiming, hs = 0;
+	int ret;
+
+	/* Unlike the older bindings, clock-div programs both divider fields. */
+	if (!i2c->clk_src_div || i2c->clk_src_div > I2C_MT6765_MAX_CLOCK_DIV ||
+	    !speed || speed > I2C_MAX_HIGH_SPEED_MODE_FREQ)
+		return -EINVAL;
+	clk_src = parent_clk / i2c->clk_src_div;
+	if (speed > I2C_MAX_FAST_MODE_PLUS_FREQ) {
+		ret = mtk_i2c_mt6765_counts(clk_src, I2C_MAX_FAST_MODE_FREQ,
+					  &low_step, &low_sample);
+		if (ret)
+			return ret;
+		ret = mtk_i2c_mt6765_counts(clk_src, speed, &step, &sample);
+		if (ret)
+			return ret;
+		timing = (low_sample << 8) | low_step;
+		hs = 0x85 | (sample << 12) | (((step - 1) & 7) << 8);
+		ltiming = 0x8000 | (low_sample << 6) | low_step |
+			  (sample << 12) | (((step + 1) & 7) << 9);
+	} else {
+		if (speed > I2C_MAX_STANDARD_MODE_FREQ && speed <= I2C_MAX_FAST_MODE_FREQ)
+			duty = 45;
+		ret = mtk_i2c_mt6765_counts(clk_src, speed * 50 / duty, &step, &sample);
+		if (ret)
+			return ret;
+		ret = mtk_i2c_mt6765_counts(clk_src, speed * 50 / (100 - duty),
+					  &low_step, &low_sample);
+		if (ret)
+			return ret;
+		timing = (sample << 8) | step;
+		ltiming = (low_sample << 6) | low_step;
+	}
+
+	i2c->timing_reg = timing;
+	i2c->ltiming_reg = ltiming;
+	i2c->high_speed_reg = hs;
+	i2c->ac_timing.inter_clk_div = (i2c->clk_src_div - 1) * 0x101;
+	i2c->hw_timeout = DIV_ROUND_UP((clk_src / 1000) * I2C_MT6765_TIMEOUT_MS,
+				       ((ltiming & 0x3f) + 1) * (((ltiming >> 6) & 7) + 1));
+	return 0;
+}
+
+static int mtk_i2c_set_speed(struct mtk_i2c *i2c, unsigned int parent_clk)
 {
 	unsigned int clk_src;
 	unsigned int step_cnt;
@@ -1079,6 +1178,10 @@ static void mtk_i2c_set_speed(struct mtk_i2c *i2c, unsigned int parent_clk)
 	unsigned int max_clk_div;
 	int ret;
 
+	if (i2c->dev_comp->mt6765_timing)
+		return mtk_i2c_set_speed_mt6765(i2c, parent_clk);
+	if (!parent_clk || !i2c->speed_hz)
+		return -EINVAL;
 	target_speed = i2c->speed_hz;
 	parent_clk /= i2c->clk_src_div;
 
@@ -1135,8 +1238,9 @@ static void mtk_i2c_set_speed(struct mtk_i2c *i2c, unsigned int parent_clk)
 					(l_sample_cnt << 6) | l_step_cnt;
 		}
 
-		break;
+		return 0;
 	}
+	return -EINVAL;
 }
 
 static void i2c_dump_register(struct mtk_i2c *i2c)
@@ -1201,6 +1305,8 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 	u16 irq_mask = mtk_i2c_irq_mask(i2c);
 	u16 clear_mask = irq_mask;
 	u16 dma_sync = 0;
+	unsigned int restart_speed = i2c->dev_comp->mt6765_timing ?
+				     I2C_MAX_FAST_MODE_FREQ : I2C_MAX_FAST_MODE_PLUS_FREQ;
 	u32 reg_4g_mode;
 	u32 reg_dma_reset;
 	u8 *dma_rd_buf = NULL;
@@ -1215,11 +1321,12 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 		clear_mask |= I2C_RS_TRANSFER | i2c->dev_comp->error_stat_mask;
 
 	reinit_completion(&i2c->msg_complete);
-	if (i2c->ch_offset) {
+	if (i2c->dev_comp->mt6765_timing) {
 		mtk_i2c_writew(i2c, 0, OFFSET_INTR_MASK);
 		mtk_i2c_configure(i2c, i2c->ch_offset);
-		mtk_i2c_reset_dma(i2c);
 	}
+	if (i2c->ch_offset)
+		mtk_i2c_reset_dma(i2c);
 
 	if (i2c->dev_comp->apdma_sync &&
 	    i2c->op != I2C_MASTER_WRRD && num > 1) {
@@ -1245,7 +1352,7 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 
 	control_reg = mtk_i2c_readw(i2c, OFFSET_CONTROL) &
 			~(I2C_CONTROL_DIR_CHANGE | I2C_CONTROL_RS);
-	if ((i2c->speed_hz > I2C_MAX_FAST_MODE_PLUS_FREQ) || (left_num >= 1))
+	if ((i2c->speed_hz > restart_speed) || (left_num >= 1))
 		control_reg |= I2C_CONTROL_RS;
 
 	if (i2c->op == I2C_MASTER_WRRD)
@@ -1459,6 +1566,12 @@ static int mtk_i2c_transfer(struct i2c_adapter *adap,
 	ret = clk_bulk_enable(I2C_MT65XX_CLK_MAX, i2c->clocks);
 	if (ret)
 		goto err_regulator;
+	if (i2c->dev_comp->mt6765_timing) {
+		ret = mtk_i2c_set_speed(i2c,
+				      clk_get_rate(i2c->clocks[I2C_MT65XX_CLK_MAIN].clk));
+		if (ret)
+			goto err_exit;
+	}
 
 	i2c->auto_restart = i2c->dev_comp->auto_restart && !i2c->ch_offset;
 
@@ -1695,7 +1808,9 @@ static int mtk_i2c_probe(struct platform_device *pdev)
 
 	strscpy(i2c->adap.name, I2C_DRV_NAME, sizeof(i2c->adap.name));
 
-	mtk_i2c_set_speed(i2c, clk_get_rate(i2c->clocks[speed_clk].clk));
+	ret = mtk_i2c_set_speed(i2c, clk_get_rate(i2c->clocks[speed_clk].clk));
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "unsupported I2C timing\n");
 
 	if (i2c->dev_comp->max_dma_support > 32) {
 		ret = dma_set_mask(&pdev->dev,
