 	u16 error_stat_mask;
@@ -343,6 +349,7 @@ struct mtk_i2c {
 	bool use_push_pull;		/* IO config push-pull mode */
 	bool clocks_prepared;
 	u16 ch_offset;			/* AP transaction register bank */
+	u16 hw_timeout;
 	u32 secure_id;			/* firmware controller ID, not adapter nr */
 
 	u16 irq_stat;			/* interrupt status */
@@ -463,7 +470,7 @@ static const struct mtk_i2c_compatible mt6765_compat = {
 	.regs = mt_i2c_regs_mt6765,
 	.auto_restart = 1,
 	.aux_len_reg = 1,
-	.timing_adjust = 1,
+	.mt6765_timing = 1,
 	.dma_sync = 1,
 	.ltiming_adjust = 1,
 	.ap_irq_gate = 1,
@@ -704,11 +711,23 @@ static void mtk_i2c_configure(struct mtk_i2c *i2c, u16 bank)
 	mtk_i2c_writew_bank(i2c, bank, i2c->high_speed_reg, OFFSET_HS);
 	if (i2c->dev_comp->ltiming_adjust)
 		mtk_i2c_writew_bank(i2c, bank, i2c->ltiming_reg, OFFSET_LTIMING);
