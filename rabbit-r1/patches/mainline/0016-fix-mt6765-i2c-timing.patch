@@ -63,6 +63,9 @@
 #define I2C_SHADOW_REG_MODE		0x0002
 #define I2C_RESUME_ARBIT			0x0002
 #define I2C_FIFO_ADDR_CLR_MCH		0x0004
+#define I2C_MT6765_TIMEOUT_EN		0x0001
+#define I2C_MT6765_MAX_CLOCK_DIV		8
+#define I2C_MT6765_TIMEOUT_MS		2
 
 #define I2C_DMA_CON_TX			0x0000
 #define I2C_DMA_CON_RX			0x0001
@@ -177,6 +180,7 @@ enum I2C_REGS_OFFSET {
 	OFFSET_HS_STA_STO_AC_TIMING,
 	OFFSET_SDA_TIMING,
 	OFFSET_MCU_INTR,
+	OFFSET_HW_TIMEOUT,
 };
 
 static const u16 mt_i2c_regs_v1[] = {
@@ -261,6 +265,7 @@ static const u16 mt_i2c_regs_mt6765[] = {
 	[OFFSET_MCU_INTR] = 0x40,
 	[OFFSET_TRANSFER_LEN_AUX] = 0x44,
 	[OFFSET_CLOCK_DIV] = 0x48,
+	[OFFSET_HW_TIMEOUT] = 0x4c,
 	[OFFSET_SOFTRESET] = 0x50,
 	[OFFSET_SCL_MIS_COMP_POINT] = 0x90,
 	[OFFSET_DEBUGSTAT] = 0xe4,
@@ -311,6 +316,7 @@ struct mtk_i2c_compatible {
