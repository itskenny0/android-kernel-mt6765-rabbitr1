 			status = "disabled";
@@ -754,7 +754,7 @@ i2c6: i2c@1100d000 {
 			clocks = <&infracfg CLK_IFR_I2C_AP>,
 				 <&infracfg CLK_IFR_AP_DMA>;
 			clock-names = "main", "dma";
-			clock-div = <1>;
+			clock-div = <5>;
 			#address-cells = <1>;
 			#size-cells = <0>;
