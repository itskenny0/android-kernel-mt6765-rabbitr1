From: itskenny0 <0@kenny.cat>
Subject: [PATCH] Update PowerVR to Linux 7.2.9

Import the complete drivers/gpu/drm/imagination subtree delta from stable
Linux v7.2.9, commit 5fce161649b4d779d1b76d9fcd52dc77779774b8.
Keep upstream source bytes and the existing pvr_drm.h UAPI unchanged.

This brings query, bounds, MMU, context cleanup and paired-job fixes plus
tracepoints. It does not add GE8320 support or enable the r1 GPU.

Source: https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tag/?h=v7.2.9

diff --git a/drivers/gpu/drm/imagination/Makefile b/drivers/gpu/drm/imagination/Makefile
index 1222a14262e4a2e5ccf236232ff3446baaa569bd..a5c5e386f16a7cb63fc4b97470505dc537bd458a 100644
--- a/drivers/gpu/drm/imagination/Makefile
+++ b/drivers/gpu/drm/imagination/Makefile
@@ -32,6 +32,9 @@ powervr-y := \
 powervr-$(CONFIG_DEBUG_FS) += \
 	pvr_debugfs.o
 
+powervr-$(CONFIG_TRACEPOINTS) += \
+	pvr_trace_points.o
+
 obj-$(CONFIG_DRM_POWERVR) += powervr.o
 
 obj-$(CONFIG_DRM_POWERVR_KUNIT_TEST) += pvr_test.o
