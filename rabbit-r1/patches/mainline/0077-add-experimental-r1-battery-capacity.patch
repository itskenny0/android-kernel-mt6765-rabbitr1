From: itskenny0 <0@kenny.cat>
Subject: [PATCH] Add experimental live r1 battery capacity

Seed a board-specific stock-profile model from bracketed live measurements
before registering CAPACITY. Track signed charge with explicit uncertainty,
expire cached estimates, and invalidate continuity across observed power
and lifetime events. Keep the uncalibrated experiment disabled by default.

diff --git a/drivers/power/supply/mt6357-gauge.c b/drivers/power/supply/mt6357-gauge.c
--- a/drivers/power/supply/mt6357-gauge.c
+++ b/drivers/power/supply/mt6357-gauge.c
@@ -4,6 +4,8 @@
 #include <linux/atomic.h>
 #include <linux/bitfield.h>
 #include <linux/cleanup.h>
+#include <linux/delay.h>
+#include <linux/pm.h>
 #include <linux/iio/consumer.h>
 #include <linux/iio/iio.h>
 #include <linux/ktime.h>
@@ -20,6 +22,10 @@
 #include <linux/regmap.h>
 #include <linux/workqueue.h>
 
+#if IS_ENABLED(CONFIG_BATTERY_MT6357_R1_SOC)
+#include "mt6357-r1-model/session.h"
+#endif
+
 #define MT6357_FG_ON		BIT(0)
 #define MT6357_FG_CLOCK_PD	(BIT(3) | BIT(4))
 #define MT6357_FG_READ_PRE	BIT(0)
@@ -76,6 +82,20 @@
 #define MT6357_READ_CAR BIT(1)
 #define MT6357_READ_BATON BIT(2)
 
