-	if (ret)
-		return ret;
-	if (!(state & MT6357_FG_ON))
-		return -EAGAIN;
-	ret = regmap_read(gauge->regmap, MT6357_BM_TOP_CKPDN_CON0, &state);
-	if (ret)
-		return ret;
-	if (state & MT6357_FG_CLOCK_PD)
-		return -EAGAIN;
-
