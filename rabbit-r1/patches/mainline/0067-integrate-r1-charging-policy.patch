@@ -75,6 +75,14 @@ properties:
       - const: chg_vddp
       - const: temp_jc
 
+  richtek,managed-charging:
+    type: boolean
+    description: |
+      Require an external charging policy on MT6370/RT5081. Initially isolate
+      input, enable the 12-hour safety timer and require charge_behaviour AUTO
