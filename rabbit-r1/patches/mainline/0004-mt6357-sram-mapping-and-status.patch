+static int mt6357_apply_mrv_mapping(struct regmap *regmap,
+				  struct mt6357_regulator_info *regulators)
+{
+	struct mt6357_regulator_info *proc = &regulators[MT6357_ID_VSRAM_PROC];
+	struct mt6357_regulator_info *others = &regulators[MT6357_ID_VSRAM_OTHERS];
+	unsigned int val;
+	int ret;
+
+	/* The vendor driver identifies MRV by TOP2_RSV0[15] (TOP2_ELR0).
+	 * This revision interchanges the two SRAM regulator register banks.
+	 */
+	ret = regmap_read(regmap, MT6357_TOP2_ELR0, &val);
+	if (ret)
+		return ret;
+
+	if (!(val & BIT(15)))
+		return 0;
+
+	swap(proc->desc.enable_reg, others->desc.enable_reg);
+	swap(proc->desc.vsel_reg, others->desc.vsel_reg);
+	swap(proc->da_vsel_reg, others->da_vsel_reg);
+	swap(proc->status_reg, others->status_reg);
+
+	return 0;
+}
+
 static int mt6357_regulator_probe(struct platform_device *pdev)
 {
 	struct mt6397_chip *mt6357 = dev_get_drvdata(pdev->dev.parent);
+	struct mt6357_regulator_info *regulators;
 	struct regulator_config config = {};
 	struct regulator_dev *rdev;
-	int i;
+	int i, ret;
+
+	/* Keep revision-specific mappings private to this PMIC instance. */
+	regulators = devm_kmemdup(&pdev->dev, mt6357_regulators,
+				 sizeof(mt6357_regulators), GFP_KERNEL);
+	if (!regulators)
+		return -ENOMEM;
+
+	ret = mt6357_apply_mrv_mapping(mt6357->regmap, regulators);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to read MT6357 revision mapping\n");
 
 	device_set_of_node_from_dev(&pdev->dev, pdev->dev.parent);
 
 	for (i = 0; i < MT6357_MAX_REGULATOR; i++) {
 		config.dev = &pdev->dev;
-		config.driver_data = &mt6357_regulators[i];
+		config.driver_data = &regulators[i];
 		config.regmap = mt6357->regmap;
 
 		rdev = devm_regulator_register(&pdev->dev,
-					       &mt6357_regulators[i].desc,
+					       &regulators[i].desc,
 					       &config);
 		if (IS_ERR(rdev)) {
 			dev_err(&pdev->dev, "failed to register %s\n",
-				mt6357_regulators[i].desc.name);
+				regulators[i].desc.name);
 			return PTR_ERR(rdev);
 		}
 	}
