From: itskenny0 <0@kenny.cat>
Subject: [PATCH] Give the memory node a unit address

LK's shipped libfdt accepts /memory lookups for memory@40000000. Use the
binding's unit-addressed name and retain the placeholder reg for LK to
replace during the Linux handoff.

diff --git a/arch/arm64/boot/dts/mediatek/mt6765-rabbit-r1.dts b/arch/arm64/boot/dts/mediatek/mt6765-rabbit-r1.dts
index d204ce007e..46d90433c6 100644
--- a/arch/arm64/boot/dts/mediatek/mt6765-rabbit-r1.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6765-rabbit-r1.dts
@@ -45,10 +45,8 @@ chosen {
 		bootargs = "earlycon=uart8250,mmio32,0x11002000 console=ttyS0,921600n8 maxcpus=1 clk_ignore_unused regulator_ignore_unused";
 	};
 
-	/* RabbitOS v0.8.293 LK looks up the exact path /memory. Keep that
-	 * name so its RAM fixup cannot leave a second, stale memory bank.
-	 */
-	memory {
+	/* LK's /memory lookup accepts this unit address and updates the reg. */
+	memory@40000000 {
 		device_type = "memory";
 		reg = <0 0x40000000 0 0x20000000>;
 	};
