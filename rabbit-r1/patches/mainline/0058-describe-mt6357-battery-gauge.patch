+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6357-gauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6357 battery gauge
+
+maintainers:
+  - itskenny0 <0@kenny.cat>
+
+description:
+  Battery current sensing in the MT6357 PMIC. The gauge is a child of the
+  PMIC MFD and uses its regmap. Positive current means charging. Current
+  measurements use the firmware-initialized gauge engine; this binding does
+  not establish support for capacity estimation or charging policy.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6357-gauge
+
+  shunt-resistor-micro-ohms:
+    description: Battery current sense resistor resistance in microohms.
+    minimum: 1
+
+  mediatek,current-gain-permille:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Board current calibration multiplier, in parts per thousand. A value
+      of 1000 leaves the shunt-corrected reading unchanged. This is the
+      applied gain, not the stock firmware's CAR_TUNE_VALUE percentage.
+    minimum: 1
+    default: 1000
+
+required:
+  - compatible
+  - shunt-resistor-micro-ohms
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    pmic {
+        gauge {
+            compatible = "mediatek,mt6357-gauge";
+            shunt-resistor-micro-ohms = <10000>;
+            mediatek,current-gain-permille = <1000>;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
--- a/MAINTAINERS
+++ b/MAINTAINERS
