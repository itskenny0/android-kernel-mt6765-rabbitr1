@@ -1338,7 +1587,7 @@ static ssize_t mtk_dsi_host_transfer(struct mipi_dsi_host *host,
 		mtk_dsi_start(dsi);
 	}
 
-	return ret < 0 ? ret : recv_cnt;
+	return ret ? ret : recv_cnt;
 }
 
