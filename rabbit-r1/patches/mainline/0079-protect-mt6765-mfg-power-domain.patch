Subject: [PATCH] pmdomain: mediatek: Validate maps and add MT6765 MFG protection

MT6765 MFG needs two ordered INFRACFG protection steps before SRAM
power-down. The vendor source asserts bit 25, then bits 21 and 22,
waiting for each acknowledgment. It releases the masks in reverse
order without polling clear acknowledgments.

Describe those steps with the existing bus-protection table API and
connect SCPSYS to the existing INFRACFG syscon through access-controllers.
The table change affects domain probe and late-init even without a GPU
node. It does not implement GPU clocks, VCORE voting or hardware APM.

Link: https://github.com/rabbit-hmi-oss/android_kernel_rabbit_mt6765/blob/8167c8c1087f057d2ef302fc93b47554291687ec/drivers/clk/mediatek/clk-mt6765-pg.c


Validate every required command and status map before powering the
domains described by DT. An absent map must not alias index zero when
legacy discovery finds only another register block. Preserve valid
legacy layouts and do not require maps for domains omitted from DT.

---
--- a/drivers/pmdomain/mediatek/mt6765-pm-domains.h
+++ b/drivers/pmdomain/mediatek/mt6765-pm-domains.h
@@ -12,6 +12,10 @@
 
 #define MT6765_PWR_STATUS 0x180
 #define MT6765_PWR_STATUS_2ND 0x184
+
+static enum scpsys_bus_prot_block scpsys_bus_prot_blocks_mt6765[] = {
+	BUS_PROT_BLOCK_INFRA,
+};
 
 static const struct scpsys_domain_data scpsys_domain_data_mt6765[] = {
 	[MT6765_POWER_DOMAIN_MD1] = {
@@ -59,6 +63,11 @@
 		.pwr_sta2nd_offs = MT6765_PWR_STATUS_2ND,
 		.sram_pdn_bits = GENMASK(8, 8),
 		.sram_pdn_ack_bits = GENMASK(12, 12),
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA, BIT(25), 0x2a0, 0x2a4, 0x228),
+			BUS_PROT_WR_IGN(INFRA, BIT(21) | BIT(22),
+					0x2a0, 0x2a4, 0x228),
+		},
 	},
 	[MT6765_POWER_DOMAIN_ISP] = {
 		.name = "isp",
@@ -120,6 +129,8 @@
 static const struct scpsys_soc_data mt6765_scpsys_data = {
 	.domains_data = scpsys_domain_data_mt6765,
 	.num_domains = ARRAY_SIZE(scpsys_domain_data_mt6765),
+	.bus_prot_blocks = scpsys_bus_prot_blocks_mt6765,
+	.num_bus_prot_blocks = ARRAY_SIZE(scpsys_bus_prot_blocks_mt6765),
 };
 
 #endif /* __MT6765_PM_DOMAINS_H */
--- a/arch/arm64/boot/dts/mediatek/mt6765.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
@@ -355,6 +355,7 @@
 			/* System Power Manager */
 			spm: power-controller {
 				compatible = "mediatek,mt6765-power-controller";
+				access-controllers = <&infracfg>;
