+    def check_io(self):
+        """Guard one serialized owner; this is not a concurrency primitive."""
+        if self._io_failure is not None:
+            raise UsbTransferError(self._io_failure)
+        if self._io_active:
+            self._io_fail("reentrant bulk operation")
+
+    def _io_fail(self, reason):
+        if self._io_failure is None:
+            self._io_failure = reason
+        raise UsbTransferError(self._io_failure)
+
+    def _io_now(self):
+        value = time.monotonic_ns()
+        if self._io_failure is not None:
+            raise UsbTransferError(self._io_failure)
+        if (type(value) is not int or value < 0 or
+                self._io_last_time is not None and value < self._io_last_time):
+            self._io_fail("invalid monotonic clock")
+        self._io_last_time = value
+        return value
+
+    def _bulk_transfer(self, operation, value, packet_size, short_read=False):
+        self.check_io()
+        self._io_active = True
+        done = calls = 0
+        wanted = 0
+        pending = False
+        try:
+            if operation == "write":
+                if type(value) is str:
+                    value = value.encode('utf-8')
+                elif type(value) is bytearray:
+                    value = bytes(value)
+                elif type(value) is array.array and value.typecode == 'B':
+                    value = value.tobytes()
+                elif type(value) is memoryview and value.ndim == 1 and value.format == 'B':
+                    value = value.tobytes()
+                elif type(value) in (list, tuple):
+                    if any(type(v) is not int or not 0 <= v <= 255 for v in value):
+                        self._io_fail("write sequence must contain byte integers")
+                    value = bytes(value)
+                if type(value) is not bytes:
+                    self._io_fail("unsupported write buffer")
+                wanted = len(value)
+            else:
+                if type(value) is not int or value < 0:
+                    self._io_fail("read length must be a nonnegative integer")
+                wanted = value
+            for number in (packet_size, self.timeout, self.BULK_TOTAL_TIMEOUT_MS,
+                           self.BULK_MAX_CALLS, self.BULK_CHUNK_SIZE):
+                if type(number) is not int or number <= 0:
+                    self._io_fail("bulk limits must be positive integers")
+            # PyUSB/libusb timeout is an unsigned millisecond value; never 0.
+            if self.timeout > 0xffffffff:
+                self._io_fail("bulk timeout exceeds the USB API range")
+            if not self.queue.empty():
+                self._io_fail("unconsumed legacy read queue")
+            deadline = self._io_now() + self.BULK_TOTAL_TIMEOUT_MS * 1000000
+            result = bytearray()
+            # An explicit empty write is one intentional zero-length packet.
+            while done < wanted or operation == "write" and wanted == 0 and calls == 0:
+                if calls >= self.BULK_MAX_CALLS:
+                    self._io_fail("bulk endpoint call budget exhausted")
+                started = self._io_now()
+                timeout = min(self.timeout, (deadline - started) // 1000000)
+                if timeout < 1:
+                    self._io_fail("bulk deadline has no complete timeout millisecond")
+                size = min(packet_size, self.BULK_CHUNK_SIZE, wanted - done)
+                calls += 1
+                pending = True
+                if operation == "write":
+                    raw = self.EP_OUT.write(value[done:done + size], timeout=timeout)
+                elif self.fast:
+                    # The buffer must match the final remainder, not the first packet.
+                    buf = array.array('B', [0]) * size
+                    raw = self.EP_IN.read(buf, timeout=timeout)
+                else:
+                    raw = self.EP_IN.read(size, timeout=timeout)
+                if self._io_failure is not None:
+                    raise UsbTransferError(self._io_failure)
+                if operation == "write" or self.fast:
+                    if type(raw) is not int or not 0 <= raw <= size:
+                        self._io_fail("invalid bulk transfer count")
+                    count = raw
+                    data = buf[:count] if operation == "read" else None
+                else:
+                    if not (type(raw) in (bytes, bytearray) or
+                            type(raw) is array.array and raw.typecode == 'B'):
+                        self._io_fail("invalid bulk read buffer")
+                    count = len(raw)
+                    if count > size:
+                        self._io_fail("overlong bulk read buffer")
+                    data = raw
+                # A read ZLP is terminal only in the explicit short-read mode.
+                if count == 0 and size != 0 and not (operation == "read" and short_read):
+                    self._io_fail("bulk transfer made no progress")
+                done += count
+                pending = False
+                if operation == "read":
+                    result.extend(data)
+                finished = self._io_now()
+                if finished >= deadline or finished >= started + timeout * 1000000:
+                    self._io_fail("bulk observed completion reached its deadline")
+                if operation == "read" and short_read and count < size:
+                    break
+            if operation == "write":
+                self.verify_data(value, "TX:")
+                if self._io_failure is not None:
+                    raise UsbTransferError(self._io_failure)
+                return True
+            if self.loglevel == logging.DEBUG:
+                self.verify_data(result, "RX:")
+                if self._io_failure is not None:
+                    raise UsbTransferError(self._io_failure)
+            return result
+        except BaseException as exc:
+            # No retry after an exception: the device may have received a prefix.
+            # Preserve the outer operation's progress even if a nested callback
+            # first latched the error and then swallowed its exception.
+            reason = self._io_failure or str(exc) or type(exc).__name__
+            self._io_failure = (f"{operation} failed: acknowledged {done}/{wanted} bytes, "
+                                f"{calls} endpoint calls, current count unknown={pending}; {reason}")
+            if not isinstance(exc, Exception):
+                raise
+            raise UsbTransferError(self._io_failure) from exc
+        finally:
+            self._io_active = False
 
