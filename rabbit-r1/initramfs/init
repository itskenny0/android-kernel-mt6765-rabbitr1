#!/bin/sh
# Runs on the r1 only. Lab initramfs: no Android, no storage mounts, root console.
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /proc /sys /run
mount -t devpts devpts /dev/pts
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
mount -t debugfs debugfs /sys/kernel/debug

echo 'haretic for rabbit r1; hardware support is experimental'
uname -a
echo 'Run r1-report for diagnostics. The expdb profile enables storage logging.'
(r1-log-start > /run/expdb-start.log 2>&1) &
(r1-log-shutdown > /run/expdb-shutdown.log 2>&1) &

# Keep each phase visible to a later pstore console registration as well as RAM.
usb_status()
{
    printf '%s\n' "$1" > /run/usb-start.status || :
    printf '<6>r1: USB ACM %s\n' "$1" > /dev/kmsg || :
    if [ "${usb_beacon:-0}" -eq 1 ]; then
        usb_beacon_uptime=unavailable
        IFS=' ' read -r usb_beacon_uptime usb_beacon_idle < /proc/uptime || usb_beacon_uptime=unavailable
        printf 'uptime=%s USB beacon: %s\n' "$usb_beacon_uptime" "$1"
        printf 'uptime=%s USB beacon: %s\n' "$usb_beacon_uptime" "$1" >> /run/usb-beacon.log || :
        printf '<6>r1: USB beacon uptime=%s %s\n' "$usb_beacon_uptime" "$1" > /dev/kmsg || :
    fi
}

usb_start()
{
    usb_beacon=0
    case " $(cat /proc/cmdline) " in
      *' r1.usb_beacon=1 '*) usb_beacon=1 ;;
    esac
    usb_status 'setup-started'
    if ! mount -t configfs configfs /sys/kernel/config; then
        usb_status 'failed: configfs mount'
        return 1
    fi
    gadget=/sys/kernel/config/usb_gadget/r1
    if ! {
        mkdir -p "$gadget" &&
        printf '0x1d6b\n' > "$gadget/idVendor" &&
        printf '0x0104\n' > "$gadget/idProduct" &&
        mkdir -p "$gadget/strings/0x409" &&
        printf 'r1-bringup\n' > "$gadget/strings/0x409/serialnumber" &&
        printf 'r1 development\n' > "$gadget/strings/0x409/manufacturer" &&
        printf 'Mainline lab console\n' > "$gadget/strings/0x409/product" &&
        mkdir -p "$gadget/configs/c.1/strings/0x409" &&
        printf 'ACM console\n' > "$gadget/configs/c.1/strings/0x409/configuration" &&
        printf '100\n' > "$gadget/configs/c.1/MaxPower" &&
        mkdir -p "$gadget/functions/acm.usb0" &&
        ln -s "$gadget/functions/acm.usb0" "$gadget/configs/c.1/"
    }; then
        usb_status 'failed: gadget setup'
        return 1
    fi

    usb_status 'waiting for UDC'
    attempt=0
    while :; do
        for controller in /sys/class/udc/*; do
            [ -e "$controller" ] || continue
            controller=${controller##*/}
            if [ "$usb_beacon" -eq 1 ]; then
                usb_status 'beacon: waiting 20s before first bind'
                if ! sleep 20; then
                    usb_status 'failed: beacon pre-bind wait'
                    return 1
                fi
            fi
            if ! printf '%s\n' "$controller" > "$gadget/UDC"; then
                usb_status "failed: bind $controller"
                return 1
            fi
            bound=
            if ! IFS= read -r bound < "$gadget/UDC" || [ "$bound" != "$controller" ]; then
                usb_status "failed: bind readback $controller"
                return 1
            fi
            usb_status "bound: $controller"
            if [ "$usb_beacon" -eq 1 ]; then
                usb_status 'beacon: bound window 10s'
                if ! sleep 10; then
                    usb_status 'failed: beacon bound wait; no unbind requested'
                    return 1
                fi
                usb_status "beacon: unbind requested: $controller"
                if ! printf '\n' > "$gadget/UDC"; then
                    usb_status "failed: beacon unbind $controller"
                    return 1
                fi
                bound=unknown
                if ! IFS= read -r bound < "$gadget/UDC" || [ -n "$bound" ]; then
                    usb_status "failed: beacon unbind readback $controller"
                    return 1
                fi
                usb_status 'beacon complete: unbound; no rebind'
                return 0
            fi
            while :; do
                getty -L -n -l /bin/sh ttyGS0 115200
                sleep 2
            done
        done
        if [ "$attempt" -ge 30 ]; then
            usb_status 'failed: UDC discovery timeout'
            return 1
        fi
        if ! sleep 1; then
            usb_status 'failed: UDC discovery wait'
            return 1
        fi
        attempt=$((attempt + 1))
    done
}

# Explicit opt-in. Discovery/setup run independently of the UART/PID1 shell.
# A bound gadget is not proof of host enumeration or physical USB operation.
case " $(cat /proc/cmdline) " in
  *' r1.usb=1 '*)
    (usb_start > /run/usb-start.log 2>&1) &
    ;;
  *) usb_status 'disabled by boot profile' ;;
esac

while :; do
    setsid cttyhack sh
    sleep 1
done
