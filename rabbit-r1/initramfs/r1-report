#!/bin/sh
# Read-only diagnostics, run on the target. Does not dump raw PMIC registers.
echo '=== Kernel and command line ==='
uname -a
cat /proc/cmdline
echo '=== Device model and compatible ==='
for name in model compatible; do
    [ ! -r "/sys/firmware/devicetree/base/$name" ] || tr '\000' '\n' < "/sys/firmware/devicetree/base/$name"
done
echo '=== I2C adapters ==='
for file in /sys/class/i2c-adapter/i2c-*/name; do
    if [ -r "$file" ]; then
        printf '%s: ' "$file"
        cat "$file"
    fi
done
echo '=== Input devices ==='
[ ! -r /proc/bus/input/devices ] || cat /proc/bus/input/devices
echo '=== Regulators ==='
for rail in /sys/class/regulator/regulator.*; do
    [ -d "$rail" ] || continue
    echo "$rail"
    for property in name state status microvolts num_users; do
        if [ -r "$rail/$property" ]; then
            printf '%s: ' "$property"
            cat "$rail/$property"
        fi
    done
done
echo '=== Regulator consumers and deferred probes ==='
for file in /sys/kernel/debug/regulator/regulator_summary /sys/kernel/debug/devices_deferred; do
    [ ! -r "$file" ] || cat "$file"
done
echo '=== Power supplies (current uA, voltage uV, temperature deci-Celsius) ==='
for supply in /sys/class/power_supply/*; do
    [ -d "$supply" ] || continue
    echo "$supply"
    if ! cat "$supply/uevent"; then
        # A failed property can abort the complete uevent. Keep other readings.
        for name in type current_now voltage_now temp; do
            [ -r "$supply/$name" ] || continue
            printf '%s: ' "$name"
            cat "$supply/$name" || echo 'unavailable'
        done
    fi
done
echo '=== Power monitor (voltage mV, current mA, chip temperature milli-Celsius) ==='
for monitor in /sys/class/hwmon/hwmon*; do
    [ -d "$monitor" ] || continue
    echo "$monitor"
    for file in "$monitor"/name "$monitor"/*_label "$monitor"/*_input; do
        if [ -r "$file" ]; then
            printf '%s: ' "${file##*/}"
            cat "$file"
        fi
    done
done
echo '=== USB device controllers ==='
ls /sys/class/udc
echo '=== Persistent kernel log ==='
for file in /run/expdb-start.log /run/expdb-logger; do
    [ ! -r "$file" ] || cat "$file"
done
ls /sys/fs/pstore
echo '=== Kernel log ==='
dmesg
