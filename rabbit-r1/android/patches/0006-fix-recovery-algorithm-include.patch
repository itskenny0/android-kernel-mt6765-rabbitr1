From: itskenny0 <0@kenny.cat>
Subject: [PATCH] Include recovery volume manager dependencies

Declare the owning headers for std::replace and std::vector explicitly.
Android 17 libc++ no longer supplies them through unrelated headers.

---
--- a/volume_manager/PublicVolume.cpp
+++ b/volume_manager/PublicVolume.cpp
@@ -30,6 +30,8 @@
 #include <android-base/stringprintf.h>
 #include <cutils/fs.h>
 #include <private/android_filesystem_config.h>
+
+#include <algorithm>
 
 #include <fcntl.h>
 #include <stdlib.h>
--- a/volume_manager/include/volume_manager/VolumeManager.h
+++ b/volume_manager/include/volume_manager/VolumeManager.h
@@ -25,6 +25,7 @@
 #include <list>
 #include <mutex>
 #include <string>
+#include <vector>
 
 struct selabel_handle;
 class NetlinkManager;
