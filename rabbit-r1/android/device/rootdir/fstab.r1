# SPDX-License-Identifier: Apache-2.0
# Stock uses md_udc for /metadata and para for /misc. Preserve those mappings.
system      /system     ext4  ro  wait,logical,first_stage_mount,slotselect,avb
system_ext  /system_ext ext4  ro  wait,logical,first_stage_mount,slotselect,avb
product     /product    ext4  ro  wait,logical,first_stage_mount,slotselect,avb
vendor      /vendor     ext4  ro  wait,logical,first_stage_mount,slotselect,avb
/dev/block/by-name/md_udc   /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata /data ext4 noatime,nosuid,nodev,noauto_da_alloc,errors=panic latemount,wait,check,quota,reservedsize=128M,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/para /misc emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/dtbo /dtbo emmc defaults slotselect
/dev/block/by-name/vbmeta /vbmeta emmc defaults slotselect
